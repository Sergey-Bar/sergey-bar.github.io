{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["http://localhost/", "http://localhost/projects/"],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "preset": "desktop"
      }
    },
    // No `preset` here on purpose: LHCI accepts only lighthouse:all,
    // lighthouse:recommended or lighthouse:no-pwa, and an invalid value makes
    // `lhci assert` abort before it asserts anything — which the action would
    // then swallow. The desktop preset is applied under collect.settings above.
    // Every route audited here must match src/content/routes.json; the budget
    // check asserts that count.
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "interactive": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
