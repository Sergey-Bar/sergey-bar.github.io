{
  "name": "sergey-bar.github.io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run stats:sync && next build && npm run build:pages",
    "build:pages": "node scripts/pages-artifacts.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "content:sync": "node scripts/generate-mjolnir.mjs",
    "content:check": "node scripts/generate-mjolnir.mjs --check",
    "stats:sync": "node scripts/sync-npm-stats.mjs",
    "budget": "node scripts/check-budget.mjs",
    "verify": "npm run content:check && npm run typecheck && npm run lint && npm run build && npm run budget"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
